# Copy to .env on the instance (never commit .env). Only secrets and per-machine paths live here.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: only needed if the HF models you pin are gated (none of the defaults are).
HF_TOKEN=
# On EC2 prefer the instance role over static keys; leave these empty there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Region of the S3 bucket; can differ from the instance's region (e.g. instance in eu-north-1)
RITIM_S3_REGION=eu-central-1
RITIM_S3_BUCKET=ritim-videos
# RITIM_WORK=/opt/dlami/nvme/ritim/work
# RITIM_MODELS=/opt/ritim/models
# RITIM_ENVS=/opt/ritim/envs
# RITIM_REPOS=/opt/ritim/repos
